VITE_AUDIOTOOL_CLIENT_ID=your-audiotool-application-client-id
# OAuth redirect origin. Must match an origin registered for the Audiotool application.
# Optional for local dev (defaults to http://127.0.0.1:5173/); required for any deploy.
VITE_AUDIOTOOL_REDIRECT_URL=https://your-deployment-origin.example.com/
